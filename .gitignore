# ==============================================================================
# .gitignore for Landslide Susceptibility Prediction Repository
# ==============================================================================

# Byte-compiled / optimized / runtime files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions & packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
conda-env/

# Jupyter Notebook checkpoints and temporary kernel data
.ipynb_checkpoints/
*-checkpoint.ipynb
.jupyter/

# IDEs and Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Unit test, coverage and linting caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# OS-generated metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment variables, local configs & secrets
.env
.env.*
*.env
*.pem
*.key
*.token

# Temporary execution outputs & scratch logs
*.log
*.tmp
*.temp
predictions_output.csv
scratch/
